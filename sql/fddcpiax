-- FUNCTION: rip_avg_nge.fddcpiax(text, double precision)

-- DROP FUNCTION IF EXISTS rip_avg_nge.fddcpiax(text, double precision);

CREATE OR REPLACE FUNCTION rip_avg_nge.fddcpiax(
	zasro text,
	p_snap_tolerance double precision DEFAULT 0.70)
    RETURNS TABLE(gid_dc2 bigint, gid_dc bigint, gid integer, sro character varying, nro character varying, length double precision, cab_type character varying, cab_capa integer, cab_modulo bigint, isole character varying, date_modif timestamp with time zone, modif_par character varying, geom geometry, cab_nature character varying, commentaire character varying, collecte character varying, cb_etiquet character varying, fon character varying, projet character varying, "DCE" character varying, dist_type text, affectation character varying, posemode integer) 
    LANGUAGE 'plpgsql'
    COST 10000
    VOLATILE PARALLEL UNSAFE
    ROWS 1000

AS $BODY$
DECLARE
    v_nb_infra integer;
    v_nb_cables integer;
    v_fallback double precision;
BEGIN
    -- =========================================================================
    -- 1. Infrastructure + BPE isoles
    -- =========================================================================
    DROP TABLE IF EXISTS temp_infra;
    CREATE TEMP TABLE temp_infra AS
    SELECT t0.gid_pt, t0.geom, t0.inf_type
    FROM rip_avg_nge.infra(zasro) t0;

    CREATE INDEX idx_tmp_infra_geom ON temp_infra USING GIST (geom);

    INSERT INTO temp_infra (gid_pt, geom, inf_type)
    SELECT 'bpe_' || b.gid, b.geom, COALESCE(b.noe_type, 'BPE')
    FROM rip_avg_nge.bpe b
    WHERE b.sro ILIKE '%' || zasro || '%'
    AND NOT EXISTS (
        SELECT 1 FROM temp_infra ti WHERE ST_DWithin(b.geom, ti.geom, 1.0)
    );

    DROP TABLE IF EXISTS temp_infra_points;
    CREATE TEMP TABLE temp_infra_points AS
    SELECT t_pts.gid_pt, t_pts.geom, t_pts.inf_type
    FROM temp_infra t_pts
    WHERE t_pts.gid_pt LIKE 'chb_%' OR t_pts.gid_pt LIKE 'pot_%'
       OR t_pts.gid_pt LIKE 'atr_%' OR t_pts.gid_pt LIKE 'bpe_%';

    CREATE INDEX idx_tmp_infra_pts_geom ON temp_infra_points USING GIST (geom);

    SELECT count(*) INTO v_nb_infra FROM temp_infra_points;
    RAISE NOTICE 'fddcpiax(%): % points infra', zasro, v_nb_infra;
    IF v_nb_infra = 0 THEN
        RAISE WARNING 'fddcpiax(%): 0 points infra -> tous les cables seront orphelins (posemode=4)', zasro;
    END IF;

    -- =========================================================================
    -- 2. Cables depuis FDDCPFA (pipeline unifie NGE + Axione)
    -- =========================================================================
    DROP TABLE IF EXISTS temp_cables;
    CREATE TEMP TABLE temp_cables AS
    SELECT t1.gid, t1.gid_dc, t1.geom, t1.sro, t1.nro, t1.cab_type, t1.cab_capa,
           t1.cab_modulo, t1.isole, t1.date_modif, t1.modif_par, t1.cab_nature,
           t1.commentaire, t1.collecte, t1.cb_etiquet, t1.fon, t1.projet,
           t1."DCE", t1.dist_type, t1.affectation
    FROM rip_avg_nge.FDDCPFA(zasro, 1) t1
    WHERE ST_IsValid(t1.geom) AND ST_Length(t1.geom) > 0.2 AND t1.geom IS NOT NULL;

    DELETE FROM temp_cables WHERE ctid IN (
        SELECT sub.ctid FROM (
            SELECT t.ctid, ROW_NUMBER() OVER (
                PARTITION BY t.gid, t.gid_dc, md5(ST_AsBinary(t.geom)) ORDER BY t.ctid
            ) AS rnum FROM temp_cables t
        ) sub WHERE sub.rnum > 1
    );

    CREATE INDEX idx_tmp_cables_geom ON temp_cables USING GIST (geom);

    SELECT count(*) INTO v_nb_cables FROM temp_cables;
    RAISE NOTICE 'fddcpiax(%): % cables charges', zasro, v_nb_cables;
    IF v_nb_cables = 0 THEN
        RAISE WARNING 'fddcpiax(%): 0 cables charges depuis FDDCPFA', zasro;
        RETURN;
    END IF;

    v_fallback := GREATEST(5.0, p_snap_tolerance * 2.0);

    -- =========================================================================
    -- 3. Projection perpendiculaire + Split + Passthrough + Posemode
    --    Projection : ST_ClosestPoint(cable, infra) -> point SUR le cable
    --    Split : uniquement si projection mid-cable (1%-99%)
    --    Passthrough : cables avec infra aux extremites, pas de split necessaire
    --    Orphan : aucune infra a proximite -> posemode=4
    -- =========================================================================
    RETURN QUERY
    WITH
    -- 3a. Projections mid-cable (evite micro-segments aux extremites)
    cable_mid_projs AS (
        SELECT t2.gid AS cable_gid, t2.gid_dc, t2.geom AS cable_geom,
               ST_Collect(proj.pt) AS proj_points
        FROM temp_cables t2
        JOIN temp_infra_points ip ON ST_DWithin(t2.geom, ip.geom, p_snap_tolerance)
        CROSS JOIN LATERAL (SELECT ST_ClosestPoint(t2.geom, ip.geom) AS pt) proj
        WHERE ST_LineLocatePoint(t2.geom, proj.pt) BETWEEN 0.01 AND 0.99
        GROUP BY t2.gid, t2.gid_dc, t2.geom
    ),
    -- 3b. Snap + Split (inline, pas de CTE intermediaire)
    split_segments AS (
        SELECT cp.cable_gid AS gid, cp.gid_dc,
               (ST_Dump(ST_Split(
                   ST_Snap(cp.cable_geom, cp.proj_points, 0.01),
                   cp.proj_points
               ))).geom AS geom
        FROM cable_mid_projs cp
    ),
    -- 3c. Passthrough : cables avec infra a proximite mais pas de projection mid
    --     (cable qui se TERMINE a un appui sans passer par d'autres)
    passthrough AS (
        SELECT tc.gid, tc.gid_dc, tc.geom
        FROM temp_cables tc
        WHERE NOT EXISTS (
            SELECT 1 FROM cable_mid_projs cp
            WHERE cp.cable_gid = tc.gid AND cp.gid_dc = tc.gid_dc
        )
        AND EXISTS (
            SELECT 1 FROM temp_infra_points ip
            WHERE ST_DWithin(tc.geom, ip.geom, p_snap_tolerance)
        )
    ),
    -- 3d. Union split + passthrough, dedup, numerotation
    all_segments AS (
        SELECT ss.gid, ss.gid_dc, ss.geom FROM split_segments ss
        WHERE ST_IsValid(ss.geom) AND ST_Length(ss.geom) > 0.2
          AND GeometryType(ss.geom) = 'LINESTRING'
        UNION ALL
        SELECT pt.gid, pt.gid_dc, pt.geom FROM passthrough pt
    ),
    unique_segments AS (
        SELECT ROW_NUMBER() OVER (ORDER BY t.gid_dc, t.gid) AS gid_dc2,
               t.gid_dc, t.gid, t.geom
        FROM (
            SELECT DISTINCT ON (v.gid_dc, v.gid, md5(ST_AsBinary(v.geom)))
                v.gid_dc, v.gid, v.geom
            FROM all_segments v
            ORDER BY v.gid_dc, v.gid, md5(ST_AsBinary(v.geom))
        ) t
    ),
    -- 3e. Endpoints + association infra (2 tiers: tolerance directe, puis 5m fallback)
    endpoints AS (
        SELECT uc.gid_dc2, uc.gid_dc, uc.gid, uc.geom,
               ST_StartPoint(uc.geom) AS sp, ST_EndPoint(uc.geom) AS ep
        FROM unique_segments uc
    ),
    infra_match AS (
        SELECT e.gid_dc2, e.gid_dc, e.gid, e.geom,
               sm.gid_pt AS start_infra, sm.inf_type AS start_inf_type,
               em.gid_pt AS end_infra, em.inf_type AS end_inf_type
        FROM endpoints e
        LEFT JOIN LATERAL (
            SELECT ip.gid_pt, ip.inf_type FROM temp_infra_points ip
            WHERE ST_DWithin(e.sp, ip.geom, v_fallback)
            ORDER BY
                CASE WHEN ST_DWithin(e.sp, ip.geom, p_snap_tolerance) THEN 0 ELSE 1 END,
                CASE WHEN ip.gid_pt NOT LIKE 'bpe_%' THEN 0 ELSE 1 END,
                ST_Distance(e.sp, ip.geom)
            LIMIT 1
        ) sm ON TRUE
        LEFT JOIN LATERAL (
            SELECT ip.gid_pt, ip.inf_type FROM temp_infra_points ip
            WHERE ST_DWithin(e.ep, ip.geom, v_fallback)
            ORDER BY
                CASE WHEN ST_DWithin(e.ep, ip.geom, p_snap_tolerance) THEN 0 ELSE 1 END,
                CASE WHEN ip.gid_pt NOT LIKE 'bpe_%' THEN 0 ELSE 1 END,
                ST_Distance(e.ep, ip.geom)
            LIMIT 1
        ) em ON TRUE
    ),
    -- 3f. Posemode
    posemode_calc AS (
        SELECT im.gid_dc2, im.gid_dc, im.gid, im.geom,
            CASE
                WHEN (im.start_infra LIKE 'atr_%' AND im.start_inf_type = 'FAC') OR
                     (im.end_infra LIKE 'atr_%' AND im.end_inf_type = 'FAC') THEN 2
                WHEN im.start_infra LIKE 'chb_%' AND im.end_infra LIKE 'chb_%' THEN 0
                WHEN (im.start_infra LIKE 'chb_%' AND im.end_infra LIKE 'atr_%') OR
                     (im.start_infra LIKE 'atr_%' AND im.end_infra LIKE 'chb_%') THEN 0
                WHEN (im.start_infra LIKE 'pot_%' AND im.end_infra LIKE 'chb_%') OR
                     (im.start_infra LIKE 'chb_%' AND im.end_infra LIKE 'pot_%') THEN 0
                WHEN (im.start_infra LIKE 'pot_%' AND im.end_infra LIKE 'atr_%' AND im.end_inf_type = 'ADR') OR
                     (im.start_infra LIKE 'atr_%' AND im.start_inf_type = 'ADR' AND im.end_infra LIKE 'pot_%') THEN 0
                WHEN im.start_infra LIKE 'pot_%' AND im.end_infra LIKE 'pot_%' THEN 1
                WHEN (im.start_infra LIKE 'pot_%' AND im.end_infra LIKE 'atr_%' AND im.end_inf_type = 'IMM') OR
                     (im.start_infra LIKE 'atr_%' AND im.start_inf_type = 'IMM' AND im.end_infra LIKE 'pot_%') THEN 1
                WHEN (im.start_infra LIKE 'bpe_%' AND im.end_infra LIKE 'pot_%') OR
                     (im.start_infra LIKE 'pot_%' AND im.end_infra LIKE 'bpe_%') THEN 1
                WHEN (im.start_infra LIKE 'bpe_%' AND im.end_infra LIKE 'chb_%') OR
                     (im.start_infra LIKE 'chb_%' AND im.end_infra LIKE 'bpe_%') THEN 0
                ELSE 4
            END AS posemode
        FROM infra_match im
    ),
    -- 3g. Resultats (join attributs cable)
    results AS (
        SELECT pc.gid_dc2, pc.gid_dc, pc.gid, t8.sro, t8.nro,
               ST_Length(pc.geom) AS length, t8.cab_type, t8.cab_capa, t8.cab_modulo,
               t8.isole, t8.date_modif, t8.modif_par,
               pc.geom::geometry(linestring, 2154) AS geom,
               t8.cab_nature, t8.commentaire, t8.collecte, t8.cb_etiquet,
               t8.fon, t8.projet, t8."DCE", t8.dist_type, t8.affectation,
               pc.posemode
        FROM posemode_calc pc
        JOIN temp_cables t8 ON pc.gid = t8.gid AND pc.gid_dc = t8.gid_dc
    ),
    -- 3h. Orphelins : aucune infra a proximite du cable entier
    orphan_cables AS (
        SELECT (900000 + ROW_NUMBER() OVER (ORDER BY tc.gid_dc, tc.gid))::bigint AS gid_dc2,
               tc.gid_dc, tc.gid, tc.sro, tc.nro,
               ST_Length(tc.geom) AS length, tc.cab_type, tc.cab_capa, tc.cab_modulo,
               tc.isole, tc.date_modif, tc.modif_par,
               tc.geom::geometry(linestring, 2154) AS geom,
               tc.cab_nature, tc.commentaire, tc.collecte, tc.cb_etiquet,
               tc.fon, tc.projet, tc."DCE", tc.dist_type, tc.affectation,
               4 AS posemode
        FROM temp_cables tc
        WHERE NOT EXISTS (
            SELECT 1 FROM temp_infra_points ip
            WHERE ST_DWithin(tc.geom, ip.geom, p_snap_tolerance)
        )
    )
    SELECT * FROM results
    UNION ALL
    SELECT * FROM orphan_cables;

END;
$BODY$;

